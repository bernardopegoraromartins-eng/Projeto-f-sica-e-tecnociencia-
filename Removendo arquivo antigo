<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Óptica da Visão - Estrutura e Funcionamento do Olho Humano">
    <meta name="author" content="Projeto de Física e Tecnociência">
    <title>Óptica da Visão – Estrutura do Olho Humano</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <!-- Container Principal -->
    <div class="main-container">
        
        <!-- Cabeçalho -->
        <header class="main-header">
            <div class="header-content">
                <h1 class="main-title">Óptica da Visão</h1>
                <p class="main-subtitle">Estrutura e Funcionamento do Olho Humano</p>
            </div>
        </header>

        <!-- Conteúdo Principal -->
        <main class="main-content">
            
            <!-- Seção do Diagrama do Olho -->
            <section class="diagram-section">
                <div class="section-header">
                    <h2>Anatomia do Olho Humano</h2>
                    <p>Clique nas partes abaixo para conhecer cada estrutura</p>
                </div>
                
                <div class="diagram-container">
                    <svg class="eye-diagram" viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Diagrama anatômico do olho humano">
                        <defs>
                            <!-- Gradiente para a esclera -->
                            <radialGradient id="scleraGradient" cx="50%" cy="50%" r="50%">
                                <stop offset="0%" style="stop-color:#f4e4c1;stop-opacity:1" />
                                <stop offset="100%" style="stop-color:#d4a574;stop-opacity:1" />
                            </radialGradient>
                            
                            <!-- Gradiente para o cristalino -->
                            <radialGradient id="lensGradient" cx="50%" cy="50%" r="50%">
                                <stop offset="0%" style="stop-color:#ffffff;stop-opacity:1" />
                                <stop offset="100%" style="stop-color:#e8f4f8;stop-opacity:1" />
                            </radialGradient>
                            
                            <!-- Gradiente para a córnea -->
                            <radialGradient id="corneaGradient" cx="50%" cy="50%" r="50%">
                                <stop offset="0%" style="stop-color:#ffffff;stop-opacity:0.9" />
                                <stop offset="100%" style="stop-color:#b8d4e3;stop-opacity:0.7" />
                            </radialGradient>
                            
                            <!-- Filtro de sombra -->
                            <filter id="dropShadow" x="-20%" y="-20%" width="140%" height="140%">
                                <feDropShadow dx="0" dy="10" stdDeviation="20" flood-opacity="0.3"/>
                            </filter>
                        </defs>

                        <!-- Esclera (camada externa) -->
                        <ellipse cx="600" cy="400" rx="380" ry="320" fill="url(#scleraGradient)" stroke="#8b7355" stroke-width="3"/>
                        
                        <!-- Coroide (camada média escura) -->
                        <ellipse cx="600" cy="400" rx="360" ry="300" fill="#2c1810"/>
                        
                        <!-- Retina (camada interna marrom) -->
                        <ellipse cx="600" cy="400" rx="340" ry="280" fill="#8b4513"/>
                        
                        <!-- Humor vítreo (gel transparente) -->
                        <ellipse cx="600" cy="400" rx="320" ry="260" fill="#f0f8ff" opacity="0.3"/>
                        
                        <!-- Cristalino (lente) -->
                        <ellipse cx="450" cy="400" rx="60" ry="120" fill="url(#lensGradient)" stroke="#a0c4e8" stroke-width="2"/>
                        
                        <!-- Córnea (parte frontal transparente) -->
                        <path d="M 220 280 Q 150 400 220 520" fill="url(#corneaGradient)" stroke="#a0c4e8" stroke-width="2"/>
                        
                        <!-- Íris (parte colorida) -->
                        <path d="M 230 300 Q 200 400 230 500" fill="#4a6741" stroke="#2d4027" stroke-width="2"/>
                        <path d="M 230 300 Q 200 400 230 500" fill="#6b8e23" opacity="0.7"/>
                        
                        <!-- Pupila (abertura preta) -->
                        <ellipse cx="220" cy="400" rx="40" ry="80" fill="#000000"/>
                        
                        <!-- Humor aquoso (líquido frontal) -->
                        <path d="M 220 280 Q 150 400 220 520 L 230 500 Q 200 400 230 300 Z" fill="#e0f0ff" opacity="0.5"/>
                        
                        <!-- Músculos ciliares -->
                        <path d="M 390 280 L 410 250 M 390 520 L 410 550" stroke="#8b4513" stroke-width="4"/>
                        <path d="M 390 280 Q 400 400 390 520" fill="none" stroke="#8b4513" stroke-width="6"/>
                        
                        <!-- Fóvea (ponto amarelo) -->
                        <circle cx="920" cy="400" r="15" fill="#ffd700" opacity="0.8"/>
                        
                        <!-- Nervo óptico -->
                        <path d="M 960 380 L 1100 360 L 1100 440 L 960 420 Z" fill="#f5deb3" stroke="#d2b48c" stroke-width="2"/>

                        <!-- Linhas de indicação e textos -->
                        <line x1="150" y1="280" x2="80" y2="240" stroke="#495057" stroke-width="1.5"/>
                        <text x="50" y="240" font-family="Segoe UI, Arial, sans-serif" font-size="14" fill="#212529" font-weight="600">Córnea</text>
                        
                        <line x1="200" y1="300" x2="120" y2="210" stroke="#495057" stroke-width="1.5"/>
                        <text x="120" y="210" font-family="Segoe UI, Arial, sans-serif" font-size="14" fill="#212529" font-weight="600">Íris</text>
                        
                        <line x1="220" y1="400" x2="80" y2="310" stroke="#495057" stroke-width="1.5"/>
                        <text x="80" y="310" font-family="Segoe UI, Arial, sans-serif" font-size="14" fill="#212529" font-weight="600">Pupila</text>
                        
                        <line x1="390" y1="400" x2="150" y2="210" stroke="#495057" stroke-width="1.5"/>
                        <text x="150" y="210" font-family="Segoe UI, Arial, sans-serif" font-size="14" fill="#212529" font-weight="600">Cristalino</text>
                        
                        <line x1="300" y1="400" x2="80" y2="540" stroke="#495057" stroke-width="1.5"/>
                        <text x="80" y="540" font-family="Segoe UI, Arial, sans-serif" font-size="14" fill="#212529" font-weight="600">Humor aquoso</text>
                        
                        <line x1="600" y1="400" x2="600" y2="650" stroke="#495057" stroke-width="1.5"/>
                        <text x="600" y="680" font-family="Segoe UI, Arial, sans-serif" font-size="14" fill="#212529" font-weight="600" text-anchor="middle">Humor vítreo</text>
                        
                        <line x1="900" y1="300" x2="900" y2="150" stroke="#495057" stroke-width="1.5"/>
                        <text x="900" y="130" font-family="Segoe UI, Arial, sans-serif" font-size="14" fill="#212529" font-weight="600" text-anchor="middle">Retina</text>
                        
                        <line x1="920" y1="400" x2="1050" y2="300" stroke="#495057" stroke-width="1.5"/>
                        <text x="1050" y="290" font-family="Segoe UI, Arial, sans-serif" font-size="14" fill="#212529" font-weight="600">Fóvea</text>
                        
                        <line x1="1000" y1="400" x2="1100" y2="320" stroke="#495057" stroke-width="1.5"/>
                        <text x="1100" y="310" font-family="Segoe UI, Arial, sans-serif" font-size="14" fill="#212529" font-weight="600">Nervo óptico</text>
                        
                        <line x1="400" y1="280" x2="400" y2="150" stroke="#495057" stroke-width="1.5"/>
                        <text x="400" y="130" font-family="Segoe UI, Arial, sans-serif" font-size="14" fill="#212529" font-weight="600" text-anchor="middle">Músculos ciliares</text>
                    </svg>
                </div>
            </section>

            <!-- Seção de Informações Detalhadas (aparece ao clicar) -->
            <section class="info-section" id="infoSection">
                <div class="info-container" id="infoContainer">
                    <div class="info-placeholder">
                        <div class="placeholder-icon">👁️</div>
                        <h3>Explore as Estruturas do Olho</h3>
                        <p>Clique em qualquer parte da legenda abaixo para ver informações detalhadas sobre cada estrutura anatômica e sua função no processo da visão.</p>
                    </div>
                </div>
            </section>

            <!-- Legenda Interativa -->
            <section class="legend-section">
                <div class="legend-header">
                    <h2>Partes do Olho</h2>
                    <p>Selecione uma estrutura para aprender mais</p>
                </div>
                
                <div class="legend-grid">
                    <!-- Item 1: Córnea -->
                    <div class="legend-card" data-structure="cornea" tabindex="0" role="button" aria-label="Ver informações sobre a Córnea">
                        <div class="card-icon">
                            <div class="icon-circle" style="background-color: #b8d4e3;"></div>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Córnea</h3>
                            <p class="card-description">Refra a luz</p>
                        </div>
                    </div>

                    <!-- Item 2: Íris -->
                    <div class="legend-card" data-structure="iris" tabindex="0" role="button" aria-label="Ver informações sobre a Íris">
                        <div class="card-icon">
                            <div class="icon-circle" style="background-color: #6b8e23;"></div>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Íris</h3>
                            <p class="card-description">Controla a pupila</p>
                        </div>
                    </div>

                    <!-- Item 3: Pupila -->
                    <div class="legend-card" data-structure="pupila" tabindex="0" role="button" aria-label="Ver informações sobre a Pupila">
                        <div class="card-icon">
                            <div class="icon-circle" style="background-color: #000000;"></div>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Pupila</h3>
                            <p class="card-description">Entrada de luz</p>
                        </div>
                    </div>

                    <!-- Item 4: Cristalino -->
                    <div class="legend-card" data-structure="cristalino" tabindex="0" role="button" aria-label="Ver informações sobre o Cristalino">
                        <div class="card-icon">
                            <div class="icon-circle" style="background-color: #e8f4f8;"></div>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Cristalino</h3>
                            <p class="card-description">Focaliza a imagem</p>
                        </div>
                    </div>

                    <!-- Item 5: Humor Aquoso -->
                    <div class="legend-card" data-structure="humor-aquoso" tabindex="0" role="button" aria-label="Ver informações sobre o Humor Aquoso">
                        <div class="card-icon">
                            <div class="icon-circle" style="background-color: #e0f0ff;"></div>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Humor Aquoso</h3>
                            <p class="card-description">Preenche a frente</p>
                        </div>
                    </div>

                    <!-- Item 6: Humor Vítreo -->
                    <div class="legend-card" data-structure="humor-vitreo" tabindex="0" role="button" aria-label="Ver informações sobre o Humor Vítreo">
                        <div class="card-icon">
                            <div class="icon-circle" style="background-color: #f0f8ff;"></div>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Humor Vítreo</h3>
                            <p class="card-description">Gel do globo ocular</p>
                        </div>
                    </div>

                    <!-- Item 7: Retina -->
                    <div class="legend-card" data-structure="retina" tabindex="0" role="button" aria-label="Ver informações sobre a Retina">
                        <div class="card-icon">
                            <div class="icon-circle" style="background-color: #8b4513;"></div>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Retina</h3>
                            <p class="card-description">Capta a imagem</p>
                        </div>
                    </div>

                    <!-- Item 8: Coroide -->
                    <div class="legend-card" data-structure="coroide" tabindex="0" role="button" aria-label="Ver informações sobre a Coroide">
                        <div class="card-icon">
                            <div class="icon-circle" style="background-color: #2c1810;"></div>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Coroide</h3>
                            <p class="card-description">Nutre a retina</p>
                        </div>
                    </div>

                    <!-- Item 9: Esclera -->
                    <div class="legend-card" data-structure="esclera" tabindex="0" role="button" aria-label="Ver informações sobre a Esclera">
                        <div class="card-icon">
                            <div class="icon-circle" style="background-color: #f4e4c1;"></div>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Esclera</h3>
                            <p class="card-description">Proteção externa</p>
                        </div>
                    </div>

                    <!-- Item 10: Nervo Óptico -->
                    <div class="legend-card" data-structure="nervo-optico" tabindex="0" role="button" aria-label="Ver informações sobre o Nervo Óptico">
                        <div class="card-icon">
                            <div class="icon-circle" style="background-color: #f5deb3;"></div>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Nervo Óptico</h3>
                            <p class="card-description">Liga ao cérebro</p>
                        </div>
                    </div>

                    <!-- Item 11: Fóvea -->
                    <div class="legend-card" data-structure="fovea" tabindex="0" role="button" aria-label="Ver informações sobre a Fóvea">
                        <div class="card-icon">
                            <div class="icon-circle" style="background-color: #ffd700;"></div>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Fóvea</h3>
                            <p class="card-description">Visão detalhada</p>
                        </div>
                    </div>

                    <!-- Item 12: Músculos Ciliares -->
                    <div class="legend-card" data-structure="musculos-ciliares" tabindex="0" role="button" aria-label="Ver informações sobre os Músculos Ciliares">
                        <div class="card-icon">
                            <div class="icon-circle" style="background-color: #8b4513;"></div>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">M. Ciliares</h3>
                            <p class="card-description">Controlam o foco</p>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- Rodapé -->
        <footer class="main-footer">
            <div class="footer-content">
                <p>&copy; 2026 Projeto de Física e Tecnociência</p>
                <p class="footer-note">Desenvolvido para fins educacionais</p>
            </div>
        </footer>
    </div>

    <!-- Script JavaScript -->
    <script src="script.js"></script>
</body>
</html>
